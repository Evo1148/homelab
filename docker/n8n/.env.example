# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-use-a-strong-random-password

# n8n credential encryption
# Keep this value stable. Changing or losing it can make stored credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-use-a-long-random-secret

# Local publishing
N8N_PUBLISHED_PORT=5678
N8N_HOST=n8n.home.arpa
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://n8n.home.arpa:5678/
WEBHOOK_URL=http://n8n.home.arpa:5678/

# For plain HTTP on a trusted LAN this may be false.
# Set to true when serving n8n over HTTPS.
N8N_SECURE_COOKIE=false

# Timezone
TZ=Europe/Madrid
