# File ownership inside the container
PUID=1000
PGID=1000

# Public-safe example values.
# Replace these locally with the real HomeLab address or internal DNS name.
FORGEJO_APP_NAME=HomeLab Forgejo
FORGEJO_DOMAIN=forgejo.home.arpa
FORGEJO_ROOT_URL=http://forgejo.home.arpa:3002/
FORGEJO_SSH_DOMAIN=forgejo.home.arpa

# Published host ports
FORGEJO_HTTP_PORT=3002
FORGEJO_SSH_PORT=2222
